#!/bin/bash

{ . ~/fzf-git.sh --run; } 2>/dev/null

# if !(_fzf_git_check); then
# 	cd "$HOME/projects/$(ls $HOME/projects | fzf)"
# fi

cd ~/projects/fe-monorepo/fe-monorepo

BASE_DIR=$(dirname $(pwd))

fzf_worktrees() {
	_fzf_git_check || return
	git worktree list | awk -F' ' '{print $1}' | xargs -L1 basename |
		_fzf_git_fzf \
			--border-label '🌴 Worktrees ' \
			--preview "
			   git -c color.status=$(__fzf_git_color .) -C ${BASE_DIR}/{1} status --short --branch
			 " "$@" | awk '{print $1}'
}

WORKTREE=$(fzf_worktrees)

WORKTREE_PATH="${BASE_DIR}/${WORKTREE}"
SESSION_NAME="worktree-${WORKTREE}"
echo $SESSION_NAME

echo $WORKTREE $WORKTREE_PATH $SESSION_NAME

if tmux has-session -t=$SESSION_NAME 2>/dev/null; then
	echo "Session $SESSION_NAME already exists"
else
	# if [[ $TERM_PROGRAM == "tmux" ]]; then
	# 	CURRENT_SESSION_NAME=$(tmux display-message -p '#S')

	# fi

	tmux new-session -d -s $SESSION_NAME
	tmux rename-window -t $SESSION_NAME 'run'
	tmux send-keys -t "${SESSION_NAME}:run" "cd ${WORKTREE_PATH}" C-m
	tmux send-keys -t "${SESSION_NAME}:run" 'pnpm caddy' C-m
	tmux new-window -t $SESSION_NAME -n app
	tmux send-keys -t "${SESSION_NAME}:app" "cd ${WORKTREE_PATH}" C-m
	tmux send-keys -t "${SESSION_NAME}:app" 'pnpm dev:customer' C-m
	tmux new-window -t $SESSION_NAME -n general
	tmux send-keys -t "${SESSION_NAME}:general" "cd ${WORKTREE_PATH}" C-m
fi

if [[ $TERM_PROGRAM == "tmux" ]]; then
	tmux switch -t=$SESSION_NAME
else
	tmux attach -t=$SESSION_NAME
fi
