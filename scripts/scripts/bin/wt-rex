#!/bin/bash
# worktrunk hooks -> Rex. The Places actions in ~/.config/rex/places.lua decide
# which session belongs to a worktree; this only hands them the paths.
#
#   post-switch:  wt-rex switch WORKTREE_PATH
#                 show (or create) the worktree's session; your pane stays put
#   post-remove:  wt-rex remove WORKTREE_PATH PRIMARY_WORKTREE_PATH
#                 close the removed worktree's session
set -euo pipefail

# Only from Rex terminals. Rex's own actions run wt without REX_SESSION, so
# they stay quiet here and manage the sessions themselves.
if [ -z "${REX_SESSION:-}" ]; then exit 0; fi

case "${1:-}" in
switch)
  rex do place_open path="$2" >/dev/null
  ;;
remove)
  # Detached: closing the session may close the terminal this hook runs in.
  nohup rex do place_close path="$2" ${3:+primary="$3"} >/dev/null 2>&1 &
  ;;
*)
  echo "usage: wt-rex switch WORKTREE_PATH | remove WORKTREE_PATH [PRIMARY_WORKTREE_PATH]" >&2
  exit 2
  ;;
esac
