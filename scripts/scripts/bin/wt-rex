#!/bin/bash
set -euo pipefail

if [ -z "${REX_SESSION:-}" ] || [ -z "${REX_BLOCK:-}" ]; then exit 0; fi

ICON=$(printf '')

session_label() {
  printf '%s %s' "$ICON" "$(basename "$1")"
}

session_id_for() {
  rex ls --json | jq -r --arg l "$1" '.sessions[] | select(.label == $l) | .session_id' | head -n1
}

block_alive() {
  rex session inspect "$REX_SESSION" --json 2>/dev/null |
    jq -e --arg b "$REX_BLOCK" '[.windows[].layers[].blocks[].block_id] | index($b)' >/dev/null
}

show_in_app() {
  rex client ls --json |
    jq -r --arg s "$REX_SESSION" '.clients[] | select(.info.kind == "app" and ((.session_ids // []) | index($s) != null)) | .client_id' |
    while read -r client; do
      rex -C "$client" do session.select session_id="$1" window_id="$2" >/dev/null || true
    done
}

switch() {
  local dir=$1 label target view tab_label created window
  label=$(session_label "$dir")
  target=$(session_id_for "$label")
  if [ "$target" = "$REX_SESSION" ]; then return 0; fi

  view=$(rex session inspect "$REX_SESSION" --json)
  tab_label=$(jq -r --arg b "$REX_BLOCK" '.windows[] | select([.layers[].blocks[].block_id] | index($b) != null) | .label' <<<"$view")
  if [[ $tab_label =~ ^Window\ [0-9a-f]{8}$ ]]; then tab_label=; fi

  if [ -n "$target" ]; then
    created=$(rex window new -s "$target" ${tab_label:+"$tab_label"} -c "$dir" --json)
    window=$(jq -r '.window_id' <<<"$created")
  else
    created=$(rex new "$label" -c "$dir" ${tab_label:+--window "$tab_label"} --json)
    target=$(jq -r '.session_id' <<<"$created")
    window=$(jq -r '.initial_windows[0].window_id' <<<"$created")
  fi

  show_in_app "$target" "$window"

  if [ "$(jq '[.windows[].layers[].blocks[]] | length' <<<"$view")" -le 1 ]; then
    rex kill "$REX_SESSION" >/dev/null
  else
    rex block close -s "$REX_SESSION" "$REX_BLOCK" >/dev/null
  fi
}

remove() {
  local target i
  target=$(session_id_for "$(session_label "$1")")
  if [ -z "$target" ]; then return 0; fi
  if [ "$target" = "$REX_SESSION" ]; then
    for i in $(seq 50); do
      block_alive || break
      sleep 0.2
    done
  fi
  rex kill "$target" >/dev/null 2>&1 || true
}

case "${1:-}" in
switch) switch "$2" ;;
remove) remove "$2" ;;
*)
  echo "usage: wt-rex switch|remove WORKTREE_PATH" >&2
  exit 2
  ;;
esac
